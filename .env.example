# Base URL of the external product catalog API
VITE_FAKE_STORE_API_URL=https://fakestoreapi.com

# Base URL of the back-end cart API
VITE_CART_API_URL=http://localhost:8000

# Base URL of the back-end auth API
VITE_AUTH_API_URL=http://localhost:8001

# Base URL of the back-end payment API
VITE_PAYMENT_API_URL=http://localhost:8002

# Base URL of the OTLP HTTP collector endpoint (traces, metrics and logs)
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service name reported in the telemetry resource attributes
VITE_OTEL_SERVICE_NAME=puc-arq-software-front
